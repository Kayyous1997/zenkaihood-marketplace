# WalletConnect Cloud project ID (publishable — safe to commit).
# Get a free one at https://cloud.reown.com and paste it below to enable
# the WalletConnect QR / mobile wallet option. Browser extension wallets
# (MetaMask, Rabby, Coinbase Wallet, ...) work without it.
VITE_WALLETCONNECT_PROJECT_ID=535acf9f46f8f279f492a746b1ec219a

# The Graph subgraph endpoint for Base Sepolia indexing.
# Get this URL from The Graph Studio after deploying the subgraph.
# Format: https://api.studio.thegraph.com/query/<id>/zenkaihood/v0.0.1
VITE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1760437/zenkaihood-1/0.0.1

